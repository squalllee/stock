{
  "name": "tdcc-mobile-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names server,assets --prefix-colors blue,green \"npm:dev:server\" \"npm:dev:assets\"",
    "dev:server": "node --watch server/index.js",
    "dev:assets": "node build.js --watch",
    "build": "node build.js",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.109.0",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.10.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "esbuild": "0.28.2",
    "supertest": "7.1.3",
    "path-to-regexp": "0.1.13"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  }
}
